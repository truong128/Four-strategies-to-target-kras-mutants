params {
    outdir = 'results'
    config = 'config.yaml'
    library = null
    training_docking_csv = null
    receptor_pdbqt = null
    center_x = null
    center_y = null
    center_z = null
    size_x = 22
    size_y = 22
    size_z = 22
    run_admet = true
    receptor_pdb = 'structures/7RPZ_KRAS_G12D_protein.pdb'
}
process {
    executor = 'local'
    errorStrategy = 'terminate'
    // Vina, Meeko, RDKit, and PyTorch live in the pdac-dd env. Nextflow work dirs do not inherit an activated
    // conda env, so scripts/run_track_a.sh exports PDAC_DD_BIN=<pdac-dd env>/bin before launching Nextflow.
    beforeScript = 'if [ -n "${PDAC_DD_BIN:-}" ]; then export PATH="$PDAC_DD_BIN:$PATH"; fi'
}
profiles {
    local { process.executor = 'local' }
    slurm { process.executor = 'slurm' }
}
timeline { enabled = true; overwrite = true; file = "${params.outdir}/timeline.html" }
report   { enabled = true; overwrite = true; file = "${params.outdir}/report.html" }
trace    { enabled = true; overwrite = true; file = "${params.outdir}/trace.txt" }
dag      { enabled = true; overwrite = true; file = "${params.outdir}/dag.html" }
