#!/usr/bin/env python3
"""Host stand-in for `apptainer run` that RFD4's OpenFold3 oracle calls.

Use this only where rootless Apptainer cannot start (unprivileged user
namespaces blocked). The OpenFold3 rootfs is imported as a Docker image (default
`of3-af3:cuda13`, override with OF3_DOCKER_IMAGE), and this wrapper maps the
oracle's argv onto `docker run`. Put this directory first on PATH to activate it.
"""

from __future__ import annotations

import os
import sys

IMAGE = os.environ.get("OF3_DOCKER_IMAGE", "of3-af3:cuda13")
PATH = "/hmmer/bin:/alphafold3_venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"


def main() -> None:
    args = sys.argv[1:]
    if args and args[0] == "run":
        args = args[1:]

    envs: list[str] = []
    binds: list[str] = []
    rest: list[str] = []
    index = 0
    while index < len(args):
        token = args[index]
        if token == "--nv":
            index += 1
            continue
        if token == "--env" and index + 1 < len(args):
            envs.append(args[index + 1])
            index += 2
            continue
        if token == "--bind" and index + 1 < len(args):
            binds.append(args[index + 1])
            index += 2
            continue
        rest.append(token)
        index += 1

    if not rest:
        sys.stderr.write("apptainer wrapper: missing image and command\n")
        sys.exit(2)
    # rest[0] is the .sif path. The container command follows it.
    command = rest[1:]
    # -i keeps stdin open. The warm worker reads one manifest path per line.
    docker = ["docker", "run", "--rm", "-i", "--gpus", "all"]
    for item in envs:
        docker.extend(["-e", item])
    docker.extend(["-e", f"PATH={PATH}"])
    seen: set[str] = set()
    for spec in binds:
        host = spec.split(":", 1)[0]
        if host in seen:
            continue
        seen.add(host)
        docker.extend(["-v", spec])
    docker.append(IMAGE)
    docker.extend(command)
    os.execvp("docker", docker)


if __name__ == "__main__":
    main()
